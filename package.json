{
	"name": "the-rift-site",
	"version": "0.0.0",
	"scripts": {
		"prestart": "npm run env",
		"prestart:prod": "npm run env -- --require-prod",
		"prebuild": "npm run env -- --require-prod",
		"prewatch": "npm run env",
		"pretest": "npm run env && npm run api:check",
		"pree2e": "npm run env",
		"pree2e:ui": "npm run env",
		"ng": "ng",
		"env": "node scripts/environments/generate.mjs",
		"api:sync": "node scripts/api-contract/sync.mjs",
		"api:check": "node scripts/api-contract/sync.mjs --check",
		"start": "ng serve",
		"start:prod": "ng serve --configuration production",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"e2e": "tsc -p e2e/tsconfig.json && playwright test",
		"e2e:ui": "tsc -p e2e/tsconfig.json && playwright test --ui",
		"prepare": "husky && npm run env",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix"
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "^21.2.14",
		"@angular/common": "^21.2.25",
		"@angular/compiler": "^21.2.25",
		"@angular/core": "^21.2.25",
		"@angular/forms": "^21.2.25",
		"@angular/material": "^21.2.14",
		"@angular/platform-browser": "^21.2.25",
		"@angular/platform-browser-dynamic": "^21.2.25",
		"@angular/router": "^21.2.25",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.1"
	},
	"devDependencies": {
		"@angular/build": "^21.2.28",
		"@angular/cli": "^21.2.28",
		"@angular/compiler-cli": "^21.2.25",
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@types/node": "^24.19.2",
		"angular-eslint": "21.4.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"lint-staged": "^17.6.0",
		"prettier": "3.9.10",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.59.2",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*.{ts,html}": [
			"eslint --fix",
			"prettier --write"
		],
		"!(*.ts|*.html)": "prettier --write --ignore-unknown"
	}
}
