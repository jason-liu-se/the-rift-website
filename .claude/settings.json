{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"worktree": { "baseRef": "head" },
	"permissions": {
		"allow": [
			"Bash(npm test:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run format:*)",
			"Bash(npm run build:*)",
			"Bash(npm run ng -- generate:*)",
			"Bash(npx prettier:*)",
			"Bash(npx eslint:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git blame:*)",
			"Bash(git branch:*)",
			"mcp__angular-cli",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git push -u origin:*)",
			"Bash(git branch -m:*)",
			"Bash(gh issue view:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr create:*)",
			"Bash(npm ci:*)",
			"Bash(npm run e2e:*)",
			"Bash(npx playwright screenshot:*)",
			"Bash(gh issue comment:*)",
			"Bash(gh api -X PATCH repos/jason-liu-se/the-rift-website/issues/comments/:*)"
		],
		"deny": [
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(git push origin main:*)"
		]
	},
	"enabledMcpjsonServers": ["angular-cli"],
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-command.mjs\""
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-command.mjs\""
					}
				]
			}
		]
	}
}
